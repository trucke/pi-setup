{
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "effect": "4.0.0-beta.98",
    "firecrawl": "^4.30.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@earendil-works/pi-tui": "^0.80.6",
    "@effect/vitest": "4.0.0-beta.98",
    "@types/node": "^26.1.1",
    "acorn": "^8.17.0",
    "prettier": "^3.9.5",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/*/*.test.ts && npm --prefix extensions/file-search test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "name": "@trucke/pi-setup",
  "version": "0.1.1",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/ask-user/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/file-search/index.ts",
      "./extensions/firecrawl-search/index.ts",
      "./extensions/git-info/index.ts",
      "./extensions/model-info/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/ui-customization/index.ts"
    ],
    "skills": [
      "./skills/background-terminals",
      "./skills/subagents",
      "./skills/svelte-code-writer",
      "./skills/svelte-core-bestpractices"
    ],
    "themes": [
      "./themes/github-dark-default.json"
    ]
  },
  "private": true
}
