{
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.219",
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "effect": "4.0.0-beta.98",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@effect/vitest": "4.0.0-beta.98",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "prettier": "^3.9.5",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/*/*.test.ts && vitest run extensions/file-search/index.spec.ts",
    "test:live": "node --test --experimental-strip-types extensions/subagents/claude.live.ts extensions/subagents/codex.live.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "name": "@trucke/pi-setup",
  "version": "0.5.1",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/ask-user/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/file-search/index.ts",
      "./extensions/openai-fast-mode/index.ts",
      "./extensions/web-search/index.ts",
      "./extensions/read-pdf/index.ts",
      "./extensions/run-timer/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/undo/index.ts",
      "./extensions/ui/index.ts"
    ],
    "skills": [
      "./skills/background-terminals",
      "./skills/subagents"
    ],
    "prompts": [
      "./prompts/recap.md"
    ],
    "themes": [
      "./themes/github-dark-default.json"
    ]
  },
  "private": true
}
