# Optional, used only by developer-search for account rate limits.
# Resolved from the process environment or ~/.pi/agent/.env.
# FIRECRAWL_API_KEY=fc-YOUR-API-KEY

# Hosted MCP search/fetch are anonymous; existing provider keys are not used.
# To enable the separate hosted fetch tool, export this in the PROCESS environment:
# PI_WEB_HOSTED_FETCH=1
